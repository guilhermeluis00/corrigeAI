generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  PROFESSOR
  COORDENADOR
  DIRETOR
}

enum Turno {
  MANHA
  TARDE
  NOITE
}

enum StatusProva {
  RASCUNHO
  PUBLICADA
  ENCERRADA
}

enum ResultadoStatus {
  PROCESSANDO
  CONCLUIDA
  ERRO
}

model Escola {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String   @unique
  codigo    String   @unique // Código de 11 caracteres repassado à equipe para o cadastro.
  email     String?
  telefone  String?
  endereco  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios    Usuario[]
  turmas      Turma[]
  disciplinas Disciplina[]
  provas      Prova[]
}

model Usuario {
  id        Int         @id @default(autoincrement())
  nome      String
  email     String      @unique
  senha     String
  tipo      TipoUsuario
  ativo     Boolean     @default(true)
  escolaId  Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  escola      Escola?          @relation(fields: [escolaId], references: [id], onDelete: SetNull)
  professores ProfessorTurma[]
  provas      Prova[]          @relation("ProfessorProvas")
  resultados  Resultado[]
  disciplinas Disciplina[]     @relation("ProfessorDisciplinas")
}

model Turma {
  id        Int      @id @default(autoincrement())
  codigo    String
  nome      String
  serie     String?
  turno     Turno?
  escolaId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escola      Escola?          @relation(fields: [escolaId], references: [id], onDelete: SetNull)
  alunos      Aluno[]
  professores ProfessorTurma[]
  provas      Prova[]

  @@unique([escolaId, codigo])
  @@index([escolaId])
}

model ProfessorTurma {
  id          Int      @id @default(autoincrement())
  professorId Int
  turmaId     Int
  createdAt   DateTime @default(now())

  professor Usuario @relation(fields: [professorId], references: [id], onDelete: Cascade)
  turma     Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([professorId, turmaId])
  @@index([turmaId])
}

model Aluno {
  id        Int      @id @default(autoincrement())
  nome      String
  matricula String
  email     String?
  turmaId   Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turma      Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  resultados Resultado[]
  respostas  Resposta[]

  @@unique([turmaId, matricula])
  @@index([turmaId])
}

model Disciplina {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  curso     String? // Curso técnico da disciplina; vazio = base comum (ensino médio).
  escolaId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escola      Escola?   @relation(fields: [escolaId], references: [id], onDelete: SetNull)
  provas      Prova[]
  professores Usuario[] @relation("ProfessorDisciplinas")

  @@unique([escolaId, nome])
  @@index([escolaId])
}

model Prova {
  id            Int         @id @default(autoincrement())
  titulo        String
  descricao     String?
  dataAplicacao DateTime?
  status        StatusProva @default(RASCUNHO)
  professorId   Int?
  disciplinaId  Int?
  turmaId       Int?
  escolaId      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  professor  Usuario?    @relation("ProfessorProvas", fields: [professorId], references: [id], onDelete: SetNull)
  disciplina Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  turma      Turma?      @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  escola     Escola?     @relation(fields: [escolaId], references: [id], onDelete: SetNull)
  questoes   Questao[]
  resultados Resultado[]

  @@index([escolaId])
  @@index([professorId])
  @@index([turmaId])
}

model Questao {
  id           Int      @id @default(autoincrement())
  provaId      Int
  numero       Int
  enunciado    String?
  alternativaA String?
  alternativaB String?
  alternativaC String?
  alternativaD String?
  alternativaE String?
  resposta     String
  valor        Float    @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prova     Prova      @relation(fields: [provaId], references: [id], onDelete: Cascade)
  respostas Resposta[]

  @@unique([provaId, numero])
  @@index([provaId])
}

model Resultado {
  id             Int             @id @default(autoincrement())
  provaId        Int
  alunoId        Int?
  usuarioId      Int?
  status         ResultadoStatus @default(PROCESSANDO)
  nota           Float?
  totalQuestoes  Int?
  acertos        Int?
  erros          Int?
  imagemOriginal String?
  erroMensagem   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  prova     Prova      @relation(fields: [provaId], references: [id], onDelete: Cascade)
  aluno     Aluno?     @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  respostas Resposta[]

  @@index([provaId])
  @@index([alunoId])
  @@index([status])
}

model Resposta {
  id            Int      @id @default(autoincrement())
  resultadoId   Int
  alunoId       Int?
  questaoId     Int
  respostaAluno String?
  correta       Boolean?
  valorObtido   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultado Resultado @relation(fields: [resultadoId], references: [id], onDelete: Cascade)
  aluno     Aluno?    @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  questao   Questao   @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@unique([resultadoId, questaoId])
  @@index([alunoId])
  @@index([questaoId])
}
